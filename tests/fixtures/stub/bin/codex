#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${ASPERA_STUB_COMMAND_LOG:-}" ]]; then
  printf '%s\n' "$*" >> "${ASPERA_STUB_COMMAND_LOG}"
fi

if [[ "${1:-}" == "--version" ]]; then
  echo "aspera-codex-stub/2.0"
  exit 0
fi

if [[ "${1:-}" == "plugin" && "${2:-}" == "marketplace" && "${3:-}" == "list" && "${4:-}" == "--json" ]]; then
  python3 - "${ASPERA_STUB_MARKETPLACE_ROOT:-}" <<'PY'
import json
import sys
root = sys.argv[1]
entries = [] if not root else [{"name": "aspera", "root": root, "marketplaceSource": {"sourceType": "local", "source": root}}]
print(json.dumps({"marketplaces": entries}))
PY
  exit 0
fi

if [[ "${1:-}" == "plugin" && "${2:-}" == "marketplace" && "${3:-}" == "add" ]]; then
  exit "${ASPERA_STUB_PLUGIN_STATUS:-0}"
fi

if [[ "${1:-}" == "plugin" && "${2:-}" == "add" && "${3:-}" == "aspera-orchestrator@aspera" ]]; then
  exit "${ASPERA_STUB_PLUGIN_STATUS:-0}"
fi

if [[ "${1:-}" == "debug" && "${2:-}" == "models" ]]; then
  echo "model catalog must not be queried by installation" >&2
  exit 88
fi

if [[ "${1:-}" == "exec" ]]; then
  echo "runtime smoke must not run during installation or diagnosis" >&2
  exit 89
fi

echo "unsupported codex stub invocation: $*" >&2
exit 90
