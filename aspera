#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SETUP_SCRIPTS="$ROOT/plugins/aspera-orchestrator/skills/setup/scripts"
PLUGIN_ID='aspera-orchestrator@aspera'
PLUGIN_NAME='aspera-orchestrator'
PLUGIN_MANIFEST="$ROOT/plugins/aspera-orchestrator/.codex-plugin/plugin.json"

usage() {
  cat <<'USAGE'
Usage:
  aspera install --workspace PATH [--profile adaptive|luna] [--install-policy|--no-policy] [--force] [--dry-run]
  aspera diagnose --workspace PATH [--profile adaptive|luna]
  aspera uninstall --workspace PATH [--force] [--dry-run]

Install is also update: it refreshes the plugin from this checkout, reconciles
the project, migrates supported state, and verifies the result. Start a new
Codex session after it succeeds; no doctor step is required.
USAGE
}

refresh_plugin() {
  [ "${ASPERA_SKIP_PLUGIN_REFRESH:-0}" != '1' ] || return 0
  local codex_bin="${ASPERA_CODEX_BIN:-codex}"
  command -v "$codex_bin" >/dev/null 2>&1 || {
    printf 'ERROR: %s is required to refresh the Aspera plugin\n' "$codex_bin" >&2
    exit 1
  }

  local temp_dir list_file marketplace_root manifest_version installed_version
  local marketplace_added=0 prior_removed=0
  temp_dir="$(mktemp -d)"
  list_file="$temp_dir/marketplaces.json"
  cleanup_refresh() { rm -rf "$temp_dir"; }
  trap cleanup_refresh EXIT INT TERM

  cleanup_added_marketplace() {
    [ "$marketplace_added" -eq 1 ] || return 0
    (cd "$temp_dir" && "$codex_bin" plugin marketplace remove aspera --json >/dev/null 2>&1) || true
  }

  cleanup_failed_first_install() {
    [ "$marketplace_added" -eq 1 ] || return 0
    (cd "$temp_dir" && "$codex_bin" plugin remove "$PLUGIN_ID" --json >/dev/null 2>&1) || true
    cleanup_added_marketplace
  }

  validate_json() {
    python3 - "$1" <<'PY'
import json
import pathlib
import sys
try:
    json.loads(pathlib.Path(sys.argv[1]).read_text(encoding='utf-8'))
except Exception:
    raise SystemExit(1)
PY
  }

  inspect_plugin_list() {
    python3 - "$1" "$PLUGIN_NAME" "$PLUGIN_ID" "$ROOT" "$2" <<'PY'
import json
import pathlib
import sys

try:
    data = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding='utf-8'))
except Exception:
    raise SystemExit(1)
name, plugin_id, expected_root, phase = sys.argv[2:6]
installed = data.get('installed')
if not isinstance(installed, list):
    raise SystemExit(1)
matches = [entry for entry in installed if isinstance(entry, dict) and entry.get('name') == name]
if len(matches) > 1:
    raise SystemExit(1)
if not matches:
    print('absent')
    raise SystemExit(0)
entry = matches[0]
marketplace = entry.get('marketplaceName')
marketplace_source = entry.get('marketplaceSource')
if entry.get('pluginId') != plugin_id or marketplace != 'aspera' or entry.get('installed') is not True:
    raise SystemExit(1)
if not isinstance(marketplace_source, dict) or marketplace_source.get('sourceType') != 'local':
    raise SystemExit(1)
source = marketplace_source.get('source')
if not isinstance(source, str) or pathlib.Path(source).resolve() != pathlib.Path(expected_root).resolve():
    raise SystemExit(1)
if phase == 'after' and entry.get('enabled') is not True:
    raise SystemExit(1)
version = entry.get('version')
if not isinstance(version, str) or not version:
    raise SystemExit(1)
print(version)
PY
  }

  manifest_version="$(python3 - "$PLUGIN_MANIFEST" <<'PY'
import json
import pathlib
import sys
try:
    data = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding='utf-8'))
except Exception:
    raise SystemExit(1)
version = data.get('version')
if not isinstance(version, str) or not version:
    raise SystemExit(1)
print(version)
PY
)" || {
    printf 'ERROR: plugin manifest is missing a valid version: %s\n' "$PLUGIN_MANIFEST" >&2
    exit 1
  }

  if ! (cd "$temp_dir" && "$codex_bin" plugin marketplace list --json > "$list_file"); then
    printf 'ERROR: failed to inspect configured Codex marketplaces\n' >&2
    exit 1
  fi
  marketplace_root="$(python3 - "$list_file" <<'PY'
import json
import pathlib
import sys
try:
    data = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding='utf-8'))
    marketplaces = data.get('marketplaces', [])
except Exception:
    raise SystemExit(1)
if not isinstance(marketplaces, list):
    raise SystemExit(1)
matches = [entry.get('root', '') for entry in marketplaces if isinstance(entry, dict) and entry.get('name') == 'aspera']
if len(matches) > 1:
    raise SystemExit(2)
print(matches[0] if matches else '')
PY
)" || {
    printf 'ERROR: Codex returned invalid or ambiguous marketplace metadata for Aspera\n' >&2
    exit 1
  }

  if [ -n "$marketplace_root" ]; then
    configured="$(cd "$marketplace_root" 2>/dev/null && pwd -P)" || {
      printf 'ERROR: configured Aspera marketplace does not exist: %s\n' "$marketplace_root" >&2
      exit 1
    }
    if [ "$configured" != "$ROOT" ]; then
      printf 'ERROR: marketplace aspera points to %s, not this checkout %s\n' "$configured" "$ROOT" >&2
      exit 1
    fi
  else
    (cd "$temp_dir" && "$codex_bin" plugin marketplace add "$ROOT" --json > "$temp_dir/marketplace-add.json") || {
      printf 'ERROR: failed to add the Aspera marketplace\n' >&2
      exit 1
    }
    marketplace_added=1
    validate_json "$temp_dir/marketplace-add.json" || {
      cleanup_added_marketplace
      printf 'ERROR: Codex returned invalid marketplace installation metadata\n' >&2
      exit 1
    }
  fi

  if ! (cd "$temp_dir" && "$codex_bin" plugin list --json > "$temp_dir/plugins-before.json"); then
    cleanup_added_marketplace
    printf 'ERROR: failed to inspect installed Codex plugins\n' >&2
    exit 1
  fi
  installed_version="$(inspect_plugin_list "$temp_dir/plugins-before.json" before)" || {
    cleanup_added_marketplace
    printf 'ERROR: installed Aspera plugin has an unexpected or ambiguous source\n' >&2
    exit 1
  }

  if [ "$installed_version" = "$manifest_version" ]; then
    (cd "$temp_dir" && "$codex_bin" plugin remove "$PLUGIN_ID" --json > "$temp_dir/plugin-remove.json") || {
      printf 'ERROR: failed to remove the same-version Aspera plugin before refresh\n' >&2
      exit 1
    }
    prior_removed=1
    validate_json "$temp_dir/plugin-remove.json" || {
      printf 'ERROR: Codex returned invalid plugin removal metadata\n' >&2
      exit 1
    }
  fi

  if ! (cd "$temp_dir" && "$codex_bin" plugin add "$PLUGIN_ID" --json > "$temp_dir/plugin-add.json"); then
    cleanup_failed_first_install
    if [ "$prior_removed" -eq 1 ]; then
      printf 'ERROR: failed to reinstall %s; the prior same-version plugin was removed and project files were not changed\n' "$PLUGIN_ID" >&2
    else
      printf 'ERROR: failed to install or refresh %s; project files were not changed\n' "$PLUGIN_ID" >&2
    fi
    exit 1
  fi
  validate_json "$temp_dir/plugin-add.json" || {
    cleanup_failed_first_install
    printf 'ERROR: Codex returned invalid plugin installation metadata; project files were not changed\n' >&2
    exit 1
  }

  if ! (cd "$temp_dir" && "$codex_bin" plugin list --json > "$temp_dir/plugins-after.json"); then
    cleanup_failed_first_install
    printf 'ERROR: failed to verify the installed Aspera plugin; project files were not changed\n' >&2
    exit 1
  fi
  installed_version="$(inspect_plugin_list "$temp_dir/plugins-after.json" after)" || {
    cleanup_failed_first_install
    printf 'ERROR: installed Aspera plugin failed source or enablement verification; project files were not changed\n' >&2
    exit 1
  }
  if [ "$installed_version" != "$manifest_version" ]; then
    cleanup_failed_first_install
    printf 'ERROR: installed Aspera plugin version %s does not match checkout version %s; project files were not changed\n' "$installed_version" "$manifest_version" >&2
    exit 1
  fi

  trap - EXIT INT TERM
  cleanup_refresh
}

[ "$#" -gt 0 ] || { usage; exit 1; }
command_name="$1"
shift

case "$command_name" in
  install)
    args=("$@")
    dry_run=0
    for arg in "${args[@]}"; do
      [ "$arg" != '--dry-run' ] || dry_run=1
    done
    if [ "$dry_run" -eq 1 ]; then
      exec bash "$SETUP_SCRIPTS/install.sh" "${args[@]}"
    fi
    bash "$SETUP_SCRIPTS/install.sh" "${args[@]}" --dry-run >/dev/null
    refresh_plugin
    exec bash "$SETUP_SCRIPTS/install.sh" "${args[@]}"
    ;;
  diagnose)
    exec bash "$SETUP_SCRIPTS/doctor.sh" "$@"
    ;;
  uninstall)
    exec bash "$SETUP_SCRIPTS/uninstall.sh" "$@"
    ;;
  --help|-h|help)
    usage
    ;;
  *)
    printf 'ERROR: unknown command: %s\n' "$command_name" >&2
    usage >&2
    exit 1
    ;;
esac
