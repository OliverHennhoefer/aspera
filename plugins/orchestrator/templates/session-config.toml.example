# Main session template for projects that want policy + runtime in one place.
# This can replace the target project's AGENTS.md policy snippet if adopted verbatim.
# Use `model_reasoning_effort = "xhigh"` because "max" is not a current schema value.

#schema = "https://developers.openai.com/codex/config-schema.json"

model = "gpt-5.6-sol"
model_provider = "openai"
model_reasoning_effort = "xhigh"
model_reasoning_summary = "concise"
model_verbosity = "low"
personality = "pragmatic"

web_search = "live"

developer_instructions = """
Use this config as the main-session policy source when installing orchestrator roles.
Run explicit packet-based delegation and keep the thread as the final decision-maker.
"""

[tools]
web_search = { context_size = "high" }
view_image = true

[permissions]
approval_policy = "on-request"
sandbox_mode = "workspace-write"
allow_login_shell = true

[sandbox_workspace_write]
network_access = false
writable_roots = []
exclude_tmpdir_env_var = false
exclude_slash_tmp = false

[agents]
enabled = true
max_concurrent_threads_per_session = 6
default_subagent_model = "gpt-5.6-luna"
default_subagent_reasoning_effort = "xhigh"
interrupt_message = true

[agents.spark]
description = "Read-only or bounded investigation and implementation support."
config_file = "./.codex/agents/spark-explorer.toml"

[agents.luna]
description = "General-purpose bounded execution and analysis support."
config_file = "./.codex/agents/luna-researcher.toml"

[agents.reviewer]
description = "Independent reviewer for correctness, edge cases, and regressions."
config_file = "./.codex/agents/terra-reviewer.toml"

[features]
multi_agent = true
enable_request_compression = true

[history]
persistence = "save-all"
